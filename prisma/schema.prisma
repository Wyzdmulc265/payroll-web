// Prisma Schema for WizTech Payroll Web App
// Run: npx prisma generate && npx prisma migrate dev

// Prisma 7 requires an explicit output path for the generated client.
// Keep this generator block intact — `output = "./generated"` is required
// by v7 and the v6 default of `node_modules/@prisma/client` no longer exists.
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Prisma 7 moved the connection URL out of the schema into prisma.config.ts.
// The datasource here only declares the database provider; the URL lives in
// the config file at the project root.
datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PAYROLL_OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum PasswordResetStatus {
  PENDING
  USED
  EXPIRED
}

model Business {
  id        String         @id @default(cuid())
  name      String
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  users          User[]
  employees      Employee[]
  payrollRecords PayrollRecord[]
  settings       Settings[]
  auditLogs      AuditLog[]

  @@map("businesses")
}

model User {
  id           String     @id @default(cuid())
  email        String
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  businessId   String?    @map("business_id")
  business     Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions       Session[]
  auditLogs      AuditLog[]      @relation("AuditLogUser")
  passwordResets PasswordReset[]
  payrollRecords PayrollRecord[] @relation("PayrollRunUser")

  // Email is unique per business so one person can hold accounts in
  // multiple businesses with the same email address. SUPER_ADMIN rows
  // have businessId = NULL; Postgres treats NULLs as distinct in a
  // composite unique constraint, so a partial unique index on email
  // WHERE business_id IS NULL (see migration) keeps those globally unique.
  @@unique([email, businessId])
  @@index([businessId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at")
  createdAt DateTime            @default(now()) @map("created_at")
  status    PasswordResetStatus @default(PENDING)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Employee {
  id                String    @id @default(cuid())
  employeeId        String    @map("employee_id") // EMP001
  businessId        String    @map("business_id")
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  fullName          String?   @map("full_name")
  nationalId        String?   @unique @map("national_id")
  employmentStatus  String    @default("Active") @map("employment_status")
  department        String
  position          String
  employmentDate    DateTime  @map("employment_date")
  employmentType    String    @default("Permanent") @map("employment_type")
  basicSalary       Decimal   @map("basic_salary") @db.Decimal(15, 2)
  salaryFrequency   String    @default("Monthly") @map("salary_frequency")
  allowances        Decimal   @default(0) @map("allowances") @db.Decimal(15, 2)
  bankName          String?   @map("bank_name")
  accountNumber     String?   @map("account_number")
  paymentMethod     String    @default("Bank Transfer") @map("payment_method")
  pensionApplicable Boolean   @default(true) @map("pension_applicable")
  taxStatus         String    @default("Taxable") @map("tax_status")
  taxNumber         String?   @map("tax_number")
  notes             String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  payrollRecords PayrollRecord[]
  auditLogs      AuditLog[]

  @@unique([employeeId, businessId])
  @@index([businessId])
  @@index([department])
  @@index([employmentStatus])
  @@index([isActive])
  @@map("employees")
}

model FringeBenefit {
  id              String        @id @default(cuid())
  payrollRecordId String        @map("payroll_record_id")
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  type         String
  description  String?
  amount       Decimal @db.Decimal(15, 2)
  taxableValue Decimal @default(0) @map("taxable_value") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([payrollRecordId])
  @@map("fringe_benefits")
}

model PayrollRecord {
  id                         String    @id @default(cuid())
  payrollPeriod              String    @map("payroll_period") // 2026-08
  periodStart                DateTime  @map("period_start")
  periodEnd                  DateTime  @map("period_end")
  employeeId                 String    @map("employee_id")
  employee                   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  businessId                 String    @map("business_id")
  business                   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department                 String
  position                   String
  basicSalary                Decimal   @map("basic_salary") @db.Decimal(15, 2)
  allowances                 Decimal   @map("allowances") @db.Decimal(15, 2)
  normalOvertimeHours        Decimal   @default(0) @map("normal_overtime_hours") @db.Decimal(8, 2)
  publicHolidayOvertimeHours Decimal   @default(0) @map("public_holiday_overtime_hours") @db.Decimal(8, 2)
  offDayOvertimeHours        Decimal   @default(0) @map("off_day_overtime_hours") @db.Decimal(8, 2)
  overtimePay                Decimal   @default(0) @map("overtime_pay") @db.Decimal(15, 2)
  bonuses                    Decimal   @default(0) @map("bonuses") @db.Decimal(15, 2)
  otherEarnings              Decimal   @default(0) @map("other_earnings") @db.Decimal(15, 2)
  grossEarnings              Decimal   @map("gross_earnings") @db.Decimal(15, 2)
  paye                       Decimal   @map("paye") @db.Decimal(15, 2)
  pensionEE                  Decimal   @map("pension_ee") @db.Decimal(15, 2)
  pensionER                  Decimal   @map("pension_er") @db.Decimal(15, 2)
  tevetLevy                  Decimal   @default(0) @map("tevet_levy") @db.Decimal(15, 2)
  fringeBenefitBase          Decimal   @default(0) @map("fringe_benefit_base") @db.Decimal(15, 2)
  fringeBenefitTax           Decimal   @default(0) @map("fringe_benefit_tax") @db.Decimal(15, 2)
  fbtSnapshot                Json?     @map("fbt_snapshot")
  otherDeductions            Decimal   @default(0) @map("other_deductions") @db.Decimal(15, 2)
  totalDeductions            Decimal   @map("total_deductions") @db.Decimal(15, 2)
  netPay                     Decimal   @map("net_pay") @db.Decimal(15, 2)
  employerCost               Decimal   @map("employer_cost") @db.Decimal(15, 2)
  configSnapshot             Json?     @map("config_snapshot") // statutory config used for this run (audit)
  runDate                    DateTime  @default(now()) @map("run_date")
  runByUserId                String?   @map("run_by_user_id")
  runByUser                  User?     @relation("PayrollRunUser", fields: [runByUserId], references: [id], onDelete: SetNull)
  status                     String    @default("Saved") @map("status")

  fringeBenefits FringeBenefit[]

  @@unique([payrollPeriod, employeeId])
  @@index([payrollPeriod])
  @@index([employeeId])
  @@index([businessId])
  @@index([runByUserId])
  @@map("payroll_records")
}

model AuditLog {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  userId      String?   @map("user_id")
  user        User?     @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  businessId  String?   @map("business_id")
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  description String
  oldValue    String?   @map("old_value")
  newValue    String?   @map("new_value")
  ipAddress   String?   @map("ip_address")
  employeeId  String?   @map("employee_id")
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([businessId, timestamp])
  @@index([userId])
  @@index([employeeId])
  @@map("audit_logs")
}

model Settings {
  id            String    @id @default(cuid())
  key           String
  value         String
  description   String?
  effectiveFrom DateTime  @map("effective_from")
  category      String // COMPANY, PAYROLL, STATUTORY, SYSTEM
  businessId    String?   @map("business_id")
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([key, businessId])
  @@index([category])
  @@index([businessId])
  @@map("settings")
}

// Malawi Statutory Configuration (stored as settings with category=STATUTORY)
// Key format: statutory.{parameter}
// Examples:
// statutory.paye_band_1_from = "0"
// statutory.paye_band_1_to = "100000"
// statutory.paye_band_1_rate = "0"
// statutory.paye_band_2_from = "100001"
// statutory.paye_band_2_to = "200000"
// statutory.paye_band_2_rate = "15"
// ...
// statutory.pension_ee_rate = "5"
// statutory.pension_er_rate = "10"
// statutory.max_pensionable_income = "1000000"
// statutory.tevet_levy_rate = "1"
// statutory.fringe_benefit_tax_rate = "30"

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key])
  @@index([resetAt])
  @@map("rate_limits")
}
