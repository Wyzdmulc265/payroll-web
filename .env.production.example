# Production environment template — fill in real values out-of-band (secret manager).
# Never commit the actual .env or .env.production.

# PostgreSQL (Neon) connection string with SSL required.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# First-run bootstrap SUPER_ADMIN (used by `prisma db seed`; see docs/AUTH-IMPLEMENTATION.md).
# Change the password immediately after first login, or leave blank to skip seeding.
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# App URL used in password-reset email links. Must be HTTPS in production.
NEXT_PUBLIC_APP_URL="https://payroll.example.com"

# Session and rate limiting (defaults shown).
SESSION_DURATION_DAYS=1
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

# SMTP (Brevo) for password-reset delivery. Values come from a secret
# manager — never commit real credentials. Port 587 uses STARTTLS.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your_brevo_smtp_login"
SMTP_PASS="your_brevo_smtp_key"
SMTP_FROM="Payroll System <your-verified-sender-email>"

NODE_ENV=production

# Field-level encryption key for employee PII (national ID, bank account, tax number).
# Generate with: openssl rand -hex 32
# MUST be set in production. Existing plaintext PII must be re-encrypted after enabling.
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
