# PostgreSQL (Neon) connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# First-run bootstrap SUPER_ADMIN (used by `prisma db seed`)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeThisPassword1

# App URL used in password-reset email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session and rate limiting (defaults shown)
SESSION_DURATION_DAYS=1
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

# SMTP for password-reset delivery via Brevo (dev convenience). If unset,
# reset links are logged to the server console (dev only — never in production).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your_brevo_smtp_login"
SMTP_PASS="your_brevo_smtp_key"
SMTP_FROM="Payroll System <your-verified-sender-email>"

NODE_ENV=development

