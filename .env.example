# PostgreSQL (Neon) connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
SESSION_COOKIE_NAME="payroll_session"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP (Brevo) — password reset / notifications
# SMTP_USER is the SMTP login provided by Brevo; SMTP_PASS is the Brevo SMTP key.
# SMTP_FROM must be a verified sender in Brevo. Never commit real secrets to Git.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your_brevo_smtp_login"
SMTP_PASS="your_brevo_smtp_key"
SMTP_FROM="Payroll System <your-verified-sender-email>"

# Rate limiting
MAX_LOGIN_ATTEMPTS="5"
RATE_LIMIT_WINDOW_MS="900000"

# Session
SESSION_DURATION_DAYS="1"
